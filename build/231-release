#!/bin/bash
set -euo pipefail

echo $0 > /var/www/html/userfiles/nems-build.cur

# Fetch NEMS version and define new string
NEMS_VER=$(/usr/local/bin/nems-info nemsver)
NEW_PRETTY_NAME="NEMS Linux ${NEMS_VER}"
OS_RELEASE="/etc/os-release"

# Load the current file
source "$OS_RELEASE"

# Unlock and remove existing file or symlink
chattr -i "$OS_RELEASE" 2>/dev/null || true
rm -f "$OS_RELEASE"

# Create new file, amalgamating our branding with the original distro info
cat <<EOF | tee "$OS_RELEASE" > /dev/null
PRETTY_NAME="${NEW_PRETTY_NAME}"
NAME="${NAME:-}"
VERSION_ID="${VERSION_ID:-}"
VERSION="${VERSION:-}"
VERSION_CODENAME="${VERSION_CODENAME:-}"
DEBIAN_VERSION_FULL="${DEBIAN_VERSION_FULL:-}"
ID="${ID:-}"
HOME_URL="https://nemslinux.com"
SUPPORT_URL="https://nemslinux.com"
BUG_REPORT_URL="https://github.com/NEMSLinux"
ARMBIAN_PRETTY_NAME="${NEW_PRETTY_NAME}"
EOF

# Prevent the file from being overwritten by future upstream updates without breaking those updates
dpkg-divert --package base-files --add --rename --divert ${OS_RELEASE}.upstream $OS_RELEASE

echo "Updated ${OS_RELEASE} to '${NEW_PRETTY_NAME}' and locked file."


# Create the issue files
echo "${NEW_PRETTY_NAME} \l" > /etc/issue
echo $NEW_PRETTY_NAME > /etc/issue.net


