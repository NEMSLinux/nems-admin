#!/bin/bash
# Glances installation script for NEMS Linux

# Install system dependencies (smartmontools replaces deprecated hddtemp)
apt-get update
apt-get install -y python3-venv python3-jinja2 python3-psutil smartmontools lm-sensors

# Ensure shared venv exists without recreating or altering existing packages
if [[ ! -d /opt/nems-venv ]]; then
  python3 -m venv /opt/nems-venv
fi

# Upgrade core pip tools in the shared venv
/opt/nems-venv/bin/pip install --upgrade pip setuptools wheel

# Safely install/upgrade Glances (excluding legacy cloud/export extras that break Debian 13)
/opt/nems-venv/bin/pip install --upgrade 'glances[action,browser,cpuinfo,docker,folders,gpu,graph,ip,raid,snmp,web,wifi]'

# Ensure symlink points to the venv binary
ln -sf /opt/nems-venv/bin/glances /usr/bin/glances

# Write unit file referencing the venv executable directly
cat <<EOF > /usr/lib/systemd/system/glancesweb.service
[Unit]
Description = Glances in Web Server Mode
After = network-online.target nss-lookup.target
Wants = network-online.target

[Service]
ExecStart = /opt/nems-venv/bin/glances -w -t 5
Restart = on-failure
RestartSec = 5s

[Install]
WantedBy = multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now glancesweb.service
systemctl disable glances
systemctl stop glances
