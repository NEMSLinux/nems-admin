#!/bin/bash
# NEMS Linux - pnp4nagios installer for NEMS Linux 1.8+
# Maintained Fork: https://github.com/pnp4nagios/pnp4nagios

echo "$0" > /var/www/html/userfiles/nems-build.cur

echo "Setting up pnp4nagios..."

# Temporary working directory setup
BUILD_DIR="/tmp/pnp4nagios-build"
rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"

# Clone latest source
git clone --depth 1 https://github.com/pnp4nagios/pnp4nagios.git "$BUILD_DIR"
cd "$BUILD_DIR" || exit 1

# Generate configure script for Debian Trixie toolchain
if command -v autoconf >/dev/null 2>&1; then
    autoconf
fi

# Detect platform target
PLATFORM=$(/usr/local/bin/nems-info platform 2>/dev/null || echo "0")

if (( PLATFORM == 20 )); then
    BUILD_TRIPLE="x86_64-unknown-linux-gnu"
elif (( PLATFORM == 21 )) || [ "$(uname -m)" = "aarch64" ]; then
    BUILD_TRIPLE="aarch64-unknown-linux-gnu"
else
    BUILD_TRIPLE=$(dpkg-architecture -qDEB_HOST_GNU_TYPE 2>/dev/null || uname -m)
fi

# Configure build
./configure \
    --with-httpd-conf=/etc/apache2/sites-enabled \
    --with-nagios-user=nagios \
    --with-nagios-group=nagios \
    --build="$BUILD_TRIPLE"

# Core compile and install
make all
make install

# Manually install Apache web configuration
if [ -f "sample-config/httpd.conf" ]; then
    cp sample-config/httpd.conf /etc/apache2/sites-enabled/pnp4nagios.conf
elif [ -f "sample-config/config_samples/apache.pnp4nagios.conf" ]; then
    cp sample-config/config_samples/apache.pnp4nagios.conf /etc/apache2/sites-enabled/pnp4nagios.conf
fi

# Manually deploy default config files if they do not exist
mkdir -p /usr/local/pnp4nagios/etc
for sample in sample-config/*.cfg-sample sample-config/*/*.cfg-sample sample-config/*.php-sample; do
    [ -f "$sample" ] || continue
    target_file="/usr/local/pnp4nagios/etc/$(basename "${sample%-sample}")"
    if [ ! -f "$target_file" ]; then
        cp "$sample" "$target_file"
    fi
done
chown -R nagios:nagios /usr/local/pnp4nagios/etc

# Patch Kohana framework for PHP 8.4 E_STRICT and E_DEPRECATED handling
if [ -d "/usr/local/pnp4nagios/share" ]; then
    find /usr/local/pnp4nagios/share/ -type f -name "*.php" -exec sed -i 's/\bE_STRICT\b/2048/g' {} +
    sed -i '/public static function error_handler/a \        if ($code === 8192 || $code === 16384) return TRUE;' /usr/local/pnp4nagios/share/kohana/system/core/Kohana.php
fi

# Deploy systemd unit for NPCD daemon if present
if [ -f "scripts/npcd.service" ]; then
    cp scripts/npcd.service /etc/systemd/system/
    systemctl enable npcd.service 2>/dev/null || true
fi

# Reload systemd and Apache
systemctl daemon-reload
systemctl restart apache2

# Cleanup build files
cd /tmp || exit 0
rm -rf "$BUILD_DIR"

# Remove the install file that blocks the interface
# If troubleshooting, replace this file and open /pnp4nagios/ to see the errors
if [[ -e /usr/local/pnp4nagios/share/install.php ]]; then
  rm -f /usr/local/pnp4nagios/share/install.php
fi

# Copy the config that points to the NEMS-based folder structure for pnp4nagios
cp /root/nems/nems-migrator/data/nagios/misc/npcd.cfg /usr/local/pnp4nagios/etc/npcd.cfg
chown nagios:nagios /usr/local/pnp4nagios/etc/npcd.cfg
chmod 644 /usr/local/pnp4nagios/etc/npcd.cfg

# Ensure log directory exists and has correct permissions
mkdir -p /usr/local/pnp4nagios/var/log/pnp4nagios
chown -R nagios:nagios /usr/local/pnp4nagios/var

# Update three required directives in process_perfdata.cfg
sed -i 's|^RRDPATH = .*|RRDPATH = /usr/local/pnp4nagios/var/perfdata|' /usr/local/pnp4nagios/etc/process_perfdata.cfg
sed -i 's|^LOG_FILE = .*|LOG_FILE = /usr/local/pnp4nagios/var/perfdata.log|' /usr/local/pnp4nagios/etc/process_perfdata.cfg
sed -i 's|^LOG_LEVEL = .*|LOG_LEVEL = 2|' /usr/local/pnp4nagios/etc/process_perfdata.cfg

# Update the config to the correct RRD destination path
sed -i 's|/usr/local/pnp4nagios/var/log/pnp4nagios/rrd|/usr/local/pnp4nagios/var/perfdata|g' /usr/local/pnp4nagios/etc/config.php

# Start and enable the NPCD service
systemctl enable --now npcd
systemctl restart npcd

# Restart Nagios to apply configuration changes
systemctl restart nagios

echo "Done."
