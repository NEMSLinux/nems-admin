#!/usr/bin/env php
<?php
/**
 * NEMS Linux Baseline Catalog Seed Exporter
 * Converts NEMS NConf database to SQL dump for NEMS Central Command Configurator import
 * Output: /usr/share/nems-ncc/schema/base.sql
 */

if (php_sapi_name() !== 'cli') {
    die("This script can only be run from the command line.\n");
}

$output_file = '/usr/share/nems-ncc/schema/base.sql';

// Parse CLI flags (-u, -p, -h, -d)
$options = getopt("u:p:h:d:", ["user:", "password:", "host:", "database:"]);

$db_host = $options['h'] ?? $options['host'] ?? 'localhost';
$db_user = $options['u'] ?? $options['user'] ?? 'nconf';
$db_pass = $options['p'] ?? $options['password'] ?? null;
$db_name = $options['d'] ?? $options['database'] ?? 'nconf';

if (empty($db_pass)) {
    $config_paths = [
        '/var/www/html/nconf/config/mysql.php',
        '/etc/nconf/mysql.php'
    ];
    foreach ($config_paths as $path) {
        if (file_exists($path)) {
            include_once $path;
            if (defined('NCONF_DB_USER') && empty($options['u']) && empty($options['user'])) $db_user = NCONF_DB_USER;
            if (defined('NCONF_DB_PASS')) $db_pass = NCONF_DB_PASS;
            if (defined('NCONF_DB_NAME') && empty($options['d']) && empty($options['database'])) $db_name = NCONF_DB_NAME;
            break;
        }
    }
}

if (empty($db_pass)) {
    echo "Enter MySQL Password for user '{$db_user}': ";
    $db_pass = trim(fgets(STDIN));
}

function generate_uuidv4() {
    $data = random_bytes(16);
    $data[6] = chr(ord($data[6]) & 0x0f | 0x40);
    $data[8] = chr(ord($data[8]) & 0x3f | 0x80);
    return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
}

function sqlite_escape(?string $str): string {
    if ($str === null || $str === '') return "''";
    return "'" . str_replace("'", "''", $str) . "'";
}

echo "=== NEMS Base Seed Exporter ===\n";

try {
    $mysql = new PDO("mysql:host={$db_host};dbname={$db_name};charset=utf8mb4", $db_user, $db_pass, [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC
    ]);

    $sql_output = "-- NEMS Linux Full Baseline Catalog Seed\n";
    $sql_output .= "-- Generated on " . date('Y-m-d H:i:s') . "\n\n";
    $sql_output .= "BEGIN TRANSACTION;\n\n";

    // Export OS Types
    echo "[+] Exporting OS Types...\n";
    $os_stmt = $mysql->query("
        SELECT i.id_item, v.attr_value AS os_name 
        FROM ConfigItems i 
        JOIN ConfigClasses c ON i.fk_id_class = c.id_class 
        JOIN ConfigValues v ON i.id_item = v.fk_id_item 
        JOIN ConfigAttrs a ON v.fk_id_attr = a.id_attr 
        WHERE c.class_name = 'os' AND a.attr_name = 'os_name'
    ");
    while ($row = $os_stmt->fetch()) {
        $uuid = generate_uuidv4();
        $name_esc = sqlite_escape($row['os_name']);
        $sql_output .= "INSERT OR IGNORE INTO os_types (uuid, name) VALUES ('{$uuid}', {$name_esc});\n";
    }

    // Export Hostgroups
    echo "[+] Exporting Hostgroups...\n";
    $hg_stmt = $mysql->query("
        SELECT i.id_item, 
               MAX(CASE WHEN a.attr_name = 'hostgroup_name' THEN v.attr_value END) AS hg_name,
               MAX(CASE WHEN a.attr_name = 'alias' THEN v.attr_value END) AS hg_alias
        FROM ConfigItems i 
        JOIN ConfigClasses c ON i.fk_id_class = c.id_class 
        JOIN ConfigValues v ON i.id_item = v.fk_id_item 
        JOIN ConfigAttrs a ON v.fk_id_attr = a.id_attr 
        WHERE c.class_name = 'hostgroup'
        GROUP BY i.id_item
    ");
    while ($row = $hg_stmt->fetch()) {
        $uuid = generate_uuidv4();
        $name_esc = sqlite_escape($row['hg_name']);
        $alias_esc = sqlite_escape($row['hg_alias'] ?: $row['hg_name']);
        $sql_output .= "INSERT OR IGNORE INTO host_groups (uuid, name, alias) VALUES ('{$uuid}', {$name_esc}, {$alias_esc});\n";
    }

    // Export Servicegroups
    echo "[+] Exporting Servicegroups...\n";
    $sg_stmt = $mysql->query("
        SELECT i.id_item, 
               MAX(CASE WHEN a.attr_name = 'servicegroup_name' THEN v.attr_value END) AS sg_name,
               MAX(CASE WHEN a.attr_name = 'alias' THEN v.attr_value END) AS sg_alias
        FROM ConfigItems i 
        JOIN ConfigClasses c ON i.fk_id_class = c.id_class 
        JOIN ConfigValues v ON i.id_item = v.fk_id_item 
        JOIN ConfigAttrs a ON v.fk_id_attr = a.id_attr 
        WHERE c.class_name = 'servicegroup'
        GROUP BY i.id_item
    ");
    while ($row = $sg_stmt->fetch()) {
        $uuid = generate_uuidv4();
        $name_esc = sqlite_escape($row['sg_name']);
        $alias_esc = sqlite_escape($row['sg_alias'] ?: $row['sg_name']);
        $sql_output .= "INSERT OR IGNORE INTO service_groups (uuid, name, alias) VALUES ('{$uuid}', {$name_esc}, {$alias_esc});\n";
    }

    // Export Commands & Misc Commands
    echo "[+] Exporting Commands...\n";
    $cmd_stmt = $mysql->query("
        SELECT i.id_item, 
               MAX(CASE WHEN a.attr_name = 'command_name' THEN v.attr_value END) AS command_name,
               MAX(CASE WHEN a.attr_name = 'command_line' THEN v.attr_value END) AS command_line
        FROM ConfigItems i
        JOIN ConfigClasses c ON i.fk_id_class = c.id_class
        JOIN ConfigValues v ON i.id_item = v.fk_id_item
        JOIN ConfigAttrs a ON v.fk_id_attr = a.id_attr
        WHERE c.class_name IN ('check-command', 'misccommand', 'command')
        GROUP BY i.id_item
    ");
    while ($row = $cmd_stmt->fetch()) {
        if (empty($row['command_name'])) continue;
        $uuid = generate_uuidv4();
        $name_esc = sqlite_escape($row['command_name']);
        $line_esc = sqlite_escape($row['command_line']);
        $sql_output .= "INSERT OR IGNORE INTO check_commands (uuid, command_name, command_line) VALUES ('{$uuid}', {$name_esc}, {$line_esc});\n";
    }

    // Export Advanced Services
    echo "[+] Exporting Advanced Services...\n";
    $adv_stmt = $mysql->query("
        SELECT i.id_item, 
               MAX(CASE WHEN a.attr_name = 'service_description' THEN v.attr_value END) AS service_desc,
               MAX(CASE WHEN a.attr_name = 'check_interval' THEN v.attr_value END) AS check_interval
        FROM ConfigItems i
        JOIN ConfigClasses c ON i.fk_id_class = c.id_class
        JOIN ConfigValues v ON i.id_item = v.fk_id_item
        JOIN ConfigAttrs a ON v.fk_id_attr = a.id_attr
        WHERE c.class_name = 'advanced-service'
        GROUP BY i.id_item
    ");
    while ($row = $adv_stmt->fetch()) {
        if (empty($row['service_desc'])) continue;
        $uuid = generate_uuidv4();
        $desc_esc = sqlite_escape($row['service_desc']);
        $interval = (int)($row['check_interval'] ?: 5);
        // We import these as global service templates in the new schema
        $sql_output .= "INSERT OR IGNORE INTO service_templates (uuid, name, check_interval, is_advanced) VALUES ('{$uuid}', {$desc_esc}, {$interval}, 1);\n";
    }

    $sql_output .= "\nCOMMIT;\n";

    if (!is_dir(dirname($output_file))) {
        mkdir(dirname($output_file), 0755, true);
    }

    // Append Base Schema Extensions
    $schema_extensions = "
-- OS Types Table
CREATE TABLE IF NOT EXISTS os_types (
    uuid TEXT PRIMARY KEY,
    name TEXT UNIQUE NOT NULL
);

-- Host Templates
CREATE TABLE IF NOT EXISTS host_templates (
    uuid TEXT PRIMARY KEY,
    name TEXT UNIQUE NOT NULL,
    check_interval INTEGER DEFAULT 5,
    retry_interval INTEGER DEFAULT 1,
    max_check_attempts INTEGER DEFAULT 10
);

-- Service Templates (including Advanced Services)
CREATE TABLE IF NOT EXISTS service_templates (
    uuid TEXT PRIMARY KEY,
    name TEXT UNIQUE NOT NULL,
    check_interval INTEGER DEFAULT 5,
    is_advanced INTEGER DEFAULT 0
);

-- Hostgroups Table
CREATE TABLE IF NOT EXISTS host_groups (
    uuid TEXT PRIMARY KEY,
    name TEXT UNIQUE NOT NULL,
    alias TEXT NOT NULL
);

-- Servicegroups Table
CREATE TABLE IF NOT EXISTS service_groups (
    uuid TEXT PRIMARY KEY,
    name TEXT UNIQUE NOT NULL,
    alias TEXT NOT NULL
);
";

    file_put_contents($output_file, $schema_extensions . "\n" . $sql_output);
    echo "[+] Exported full NEMS baseline catalog cleanly to: {$output_file}\n";

} catch (Exception $e) {
    echo "[-] Error connecting to MySQL or exporting seed: " . $e->getMessage() . "\n";
    exit(1);
}
